(()=>{
'use strict';
if(window.__FF_OPTIONS_TORTUGA_V11__) return;
window.__FF_OPTIONS_TORTUGA_V11__=true;

const STORE='ff_options_safe_v9';
const BASE_KEYS=['ff_mi_plan_v2','ff_mi_plan_v4'];
const MONTHS={JAN:0,FEB:1,MAR:2,APR:3,MAY:4,JUN:5,JUL:6,AUG:7,SEP:8,OCT:9,NOV:10,DEC:11};
const euro=(v,compact=false,currency='USD')=>new Intl.NumberFormat('es-ES',{style:'currency',currency,maximumFractionDigits:0,notation:compact?'compact':'standard'}).format(Number(v)||0);
const pct=v=>`${new Intl.NumberFormat('es-ES',{maximumFractionDigits:1}).format(Number(v)||0)}%`;
const num=v=>{const n=Number(String(v??'').replace(',','.'));return Number.isFinite(n)?n:0};
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const readJSON=k=>{try{return JSON.parse(localStorage.getItem(k)||'null')}catch(_){return null}};
const save=d=>localStorage.setItem(STORE,JSON.stringify(d));
const read=()=>readJSON(STORE)||{strategy:{delta:.05,minDte:28,maxDte:56,targetProfit:30},imports:[],open:[],trades:[],events:[],summary:null};
const baseData=()=>readJSON(BASE_KEYS.find(k=>localStorage.getItem(k))||BASE_KEYS[0]);
const datePart=v=>String(v||'').slice(0,10);
const monthKey=v=>datePart(v).slice(0,7);
const monthName=k=>{if(!k)return'';const[y,m]=k.split('-').map(Number);return new Intl.DateTimeFormat('es-ES',{month:'short'}).format(new Date(y,m-1,1)).replace('.','').toUpperCase()};
const longDate=v=>{const d=new Date(datePart(v)+'T12:00:00');return Number.isNaN(d)?String(v):new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'short'}).format(d)};
const contractKey=t=>[t.underlying,t.expiry,t.strike,t.right].join('|');

const style=document.createElement('style');
style.dataset.optionsTortugaV11='1';
style.textContent=`
.ot11{--bg:#06101f;--panel:#0b1728;--panel2:#0e1d32;--line:#20334e;--muted:#8fa3bf;--text:#f5f8ff;--blue:#3784ff;--orange:#ff7a16;--green:#35d0a1;--red:#ff6574;min-height:70vh;margin:-4px -2px 100px;padding:16px;border-radius:28px;background:radial-gradient(circle at 85% 0,rgba(55,132,255,.16),transparent 28%),radial-gradient(circle at 10% 16%,rgba(255,122,22,.1),transparent 24%),var(--bg);color:var(--text);box-shadow:0 28px 80px rgba(4,16,34,.22)}
.ot11 *{box-sizing:border-box}.ot11 button,.ot11 input,.ot11 select{font:inherit}.ot11-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;padding:10px 6px 18px}.ot11-title small{display:flex;align-items:center;gap:8px;color:#79aaff;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.ot11-title small i{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px rgba(53,208,161,.1)}.ot11-title h2{margin:7px 0 5px;font-size:clamp(29px,7vw,46px);letter-spacing:-.045em}.ot11-title p{margin:0;color:var(--muted);font-size:13px}.ot11-actions{display:flex;gap:9px;flex-wrap:wrap;justify-content:flex-end}.ot11-btn{border:1px solid var(--line);border-radius:14px;padding:11px 14px;background:#0c1c31;color:var(--text);font-weight:850;font-size:13px;cursor:pointer}.ot11-btn.primary{border-color:transparent;background:linear-gradient(135deg,#ff8d24,#ff680a);box-shadow:0 10px 30px rgba(255,122,22,.22)}.ot11-btn.blue{border-color:transparent;background:linear-gradient(135deg,#3784ff,#1b5cc4)}.ot11-tabs{position:sticky;top:0;z-index:15;display:flex;gap:5px;overflow:auto;margin:0 0 14px;padding:5px;border:1px solid var(--line);border-radius:16px;background:rgba(6,16,31,.88);backdrop-filter:blur(14px)}.ot11-tabs button{flex:0 0 auto;border:0;border-radius:11px;padding:10px 14px;background:transparent;color:var(--muted);font-weight:850;font-size:12px;cursor:pointer}.ot11-tabs button.active{background:#17345c;color:#fff;box-shadow:inset 0 0 0 1px #315b91}.ot11-view{display:none}.ot11-view.active{display:grid;gap:14px}.ot11-summary{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.ot11-kpi{min-height:114px;padding:15px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,var(--panel2),var(--panel));box-shadow:0 13px 34px rgba(0,0,0,.12)}.ot11-kpi span{display:flex;align-items:center;gap:6px;color:var(--muted);font-size:11px;font-weight:800}.ot11-kpi strong{display:block;margin-top:13px;font-size:clamp(20px,3vw,29px);letter-spacing:-.035em}.ot11-kpi small{display:block;margin-top:5px;color:#6f86a7;font-size:10px;line-height:1.3}.ot11-kpi strong.good{color:var(--green)}.ot11-kpi strong.bad{color:var(--red)}.ot11-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:14px}.ot11-card{position:relative;overflow:hidden;padding:18px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,rgba(15,31,53,.98),rgba(8,21,37,.98));box-shadow:0 16px 45px rgba(0,0,0,.13)}.ot11-card.full{grid-column:1/-1}.ot11-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:14px}.ot11-card-head h3{margin:0;font-size:17px}.ot11-card-head p{margin:5px 0 0;color:var(--muted);font-size:11px;line-height:1.45}.ot11-big{font-size:26px;font-weight:950;letter-spacing:-.04em;text-align:right}.ot11-big small{display:block;margin-top:3px;color:var(--muted);font-size:10px;font-weight:750;letter-spacing:0}.ot11-svg{display:block;width:100%;height:auto;overflow:visible}.ot11-gridline{stroke:#1d304a;stroke-width:1}.ot11-axis{fill:#7188a8;font:700 10px system-ui}.ot11-line{fill:none;stroke:url(#ot11Line);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}.ot11-area{fill:url(#ot11Area)}.ot11-dot{fill:#0b1728;stroke:#ff7a16;stroke-width:3}.ot11-zero{stroke:#607b9f;stroke-width:1}.ot11-months{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.ot11-month{min-height:87px;padding:11px;border:1px solid #1b304c;border-radius:14px;background:#091729}.ot11-month span{color:#6f87a8;font-size:10px;font-weight:900}.ot11-month b{display:block;margin-top:8px;font-size:16px}.ot11-month small{display:block;margin-top:4px;color:#69809f;font-size:9px}.ot11-month.good b{color:var(--green)}.ot11-month.bad b{color:var(--red)}.ot11-month.empty{opacity:.55}.ot11-calendar{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.ot11-weekday{padding:5px 0;color:#607a9b;text-align:center;font-size:9px;font-weight:900}.ot11-day{position:relative;min-height:62px;padding:7px;border:1px solid #1c304b;border-radius:10px;background:#091526}.ot11-day.blank{border-color:transparent;background:transparent}.ot11-day span{color:#7890b0;font-size:9px;font-weight:850}.ot11-day b{display:block;margin-top:11px;font-size:10px;text-align:right}.ot11-day.good{background:linear-gradient(145deg,rgba(53,208,161,var(--heat)),#091526)}.ot11-day.bad{background:linear-gradient(145deg,rgba(255,101,116,var(--heat)),#091526)}.ot11-rank{display:grid;gap:10px}.ot11-rank-row{display:grid;grid-template-columns:58px 1fr auto;gap:10px;align-items:center}.ot11-rank-row>span{font-size:12px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ot11-track{height:12px;border-radius:999px;background:#17283e;overflow:hidden}.ot11-track i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#3784ff,#ff7a16);transform-origin:left;animation:ot11grow .65s ease both}.ot11-rank-row b{font-size:11px}.ot11-list{display:grid;gap:8px}.ot11-trade{display:grid;grid-template-columns:minmax(150px,1.4fr) .7fr .6fr .6fr;gap:10px;align-items:center;padding:12px;border:1px solid #1a2e48;border-radius:14px;background:#091728}.ot11-trade