      .prop1511-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.prop1511-field{display:block;color:var(--muted);font-size:10px;font-weight:850}.prop1511-field input,.prop1511-field select{width:100%;min-height:48px;margin-top:6px;padding:0 12px;border:1px solid var(--line);border-radius:13px;background:#fff;color:var(--ink);font:700 14px system-ui}
      .prop1511-segments{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:7px}.prop1511-segments.three{grid-template-columns:repeat(3,1fr)}.prop1511-segments button{min-height:47px;border:1px solid var(--line);border-radius:13px;background:#f8fbfe;color:#486079;font:850 11px system-ui}.prop1511-segments button.active{border-color:#67a7df;background:#edf7ff;color:#075ca7;box-shadow:0 0 0 3px rgba(22,116,209,.08)}
      .prop1511-methods{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:9px}.prop1511-methods button{min-height:43px;border:1px solid var(--line);border-radius:12px;background:#f7fafc;color:#415a75;font:850 10px system-ui}.prop1511-methods button.active{border-color:#65a5dc;background:#edf7ff;color:#075ca7}
      .prop1511-upload{display:flex;align-items:center;justify-content:center;min-height:48px;margin-top:9px;border:1px dashed #78a8d7;border-radius:13px;background:#f5faff;color:#145b9c;font:900 11px system-ui}.prop1511-upload input{display:none}.prop1511-status{margin-top:8px;padding:9px 10px;border-radius:12px;background:#eef8f3;color:#17634d;font-size:10px;font-weight:850;line-height:1.4}.prop1511-note{padding:11px 12px;border-radius:14px;background:#fff7e9;color:#76501b;font-size:10px;line-height:1.5}
      .prop1511-estimate{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:9px;padding:11px;border-radius:13px;background:#eef6ff}.prop1511-estimate span{color:var(--muted);font-size:9px}.prop1511-estimate strong{font-size:17px}
      .prop1511-actions{display:flex;gap:9px;flex-wrap:wrap}.prop1511-primary,.prop1511-soft,.prop1511-danger{min-height:49px;padding:0 16px;border-radius:14px;font:900 12px system-ui}.prop1511-primary{flex:1;border:0;background:linear-gradient(135deg,#ff941f,#ff790b);color:#fff;box-shadow:0 12px 25px rgba(255,126,15,.22)}.prop1511-soft{border:1px solid #a7c7e5;background:#edf6ff;color:#145b9c}.prop1511-danger{border:1px solid #efb9c0;background:#fff4f5;color:#a73e4b}
      .prop1511-list{display:grid;gap:9px}.prop1511-row{display:grid;grid-template-columns:42px 1fr auto;gap:11px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:16px;background:#fff}.prop1511-icon{display:grid;place-items:center;width:40px;height:40px;border-radius:13px;background:#e8f2fc;color:#125b99;font-size:18px}.prop1511-row b,.prop1511-row small{display:block}.prop1511-row small{margin-top:3px;color:var(--muted);font-size:9px;line-height:1.4}.prop1511-row button{border:0;background:transparent;color:#1262aa;font-weight:900}
      .prop1511-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.prop1511-summary div{padding:12px;border-radius:15px;background:#f3f7fb}.prop1511-summary span{display:block;color:var(--muted);font-size:8px}.prop1511-summary strong{display:block;margin-top:5px;font-size:16px}
      .prop1511-progress{position:fixed;inset:0;z-index:25000;display:grid;place-items:center;background:#04101dca}.prop1511-progress>div{width:min(390px,calc(100% - 28px));padding:20px;border-radius:20px;background:#0d2745;color:#fff}.prop1511-progress span{display:block;margin-top:7px;color:#bad0e4;font-size:11px}
      .prop1511-dialog{width:min(520px,calc(100% - 24px));padding:0;border:0;border-radius:22px;background:#0d2745;color:#fff}.prop1511-dialog::backdrop{background:#020812c4}.prop1511-dialog form{padding:18px}.prop1511-dialog h3{margin:4px 0}.prop1511-dialog label{display:block;margin-top:12px;color:#b6c9db;font-size:10px}.prop1511-dialog input{width:100%;min-height:47px;margin-top:6px;padding:0 12px;border:1px solid #34536f;border-radius:12px;background:#071a2e;color:#fff;font-size:16px}.prop1511-dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:15px}.prop1511-dialog-actions button{min-height:43px;padding:0 13px;border-radius:12px;border:1px solid #34536f;background:#102c4b;color:#fff;font-weight:850}.prop1511-dialog-actions .primary{border:0;background:#1674d1}
      #portraitNext.prop1511-native-hidden{display:none!important}
      @media(max-width:560px){.prop1511-grid{grid-template-columns:1fr}.prop1511-methods{grid-template-columns:1fr}.prop1511-summary{grid-template-columns:1fr 1fr}.prop1511-summary div:first-child{grid-column:1/-1}}
    `;
    document.head.appendChild(style);
  }

  function ensureDialog() {
    if ($('#prop1511Review')) return;
    document.body.insertAdjacentHTML('beforeend', `<dialog id="prop1511Review" class="prop1511-dialog"><form method="dialog"><small>LECTURA DEL DOCUMENTO</small><h3>Confirma el importe detectado</h3><div data-prop1511-review></div></form></dialog>`);
  }

  async function loadOCR() {
    if (globalThis.Tesseract?.recognize) return globalThis.Tesseract;
