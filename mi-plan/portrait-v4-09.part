 en el centro.','👤']:s.kind==='income'?['¡Ritmo entendido!','Ya podemos medir tu capacidad real.','🚀']:s.kind==='goal'?['¡Objetivo elegido!','El panel sabrá qué progreso destacar.','🎯']:['¡Controles preparados!','Tus reglas personales quedan guardadas.','🛡️'];joy(...msg,()=>{state.step++;render()})};
  document.addEventListener('click',e=>{if(e.target.closest('[data-close-help]'))$('#portraitHelp').close()});$('#portraitHelp').addEventListener('click',e=>{if(e.target===$('#portraitHelp'))$('#portraitHelp').close()});
  function finish(){const t=totals(),deadline=new Date();deadline.setFullYear(deadline.getFullYear()+state.horizon);const owner=state.household==='individual'?(state.name||'Personal'):state.household==='couple'?'Pareja':'Familiar';const items=DISCOVERY.filter(d=>state.answers[d.type]==='yes').map(d=>{const m=meta(d.type);return{id:id(),name:m.where||(d.type==='realestate'?(m.count>1?`${m.count} inmuebles`:'Inmueble'):TYPES[d.type].label),type:d.type,value:safe(state.values[d.type]),monthlyIncome:safe(m.monthlyIncome),owner,source:'estimated',sourceLabel:m.unknown?'Pendiente':'Estimado',institution:m.where,count:m.count,monthlyContribution:m.monthlyContribution,monthlyPayment:m.monthlyPayment,updatedAt:now()}});const current=calcGoalCurrent();const payload={version:2,onboardingComplete:true,profile:{name:state.name||'Usuario',household:state.household,detail:state.detail,reviewFrequency:state.frequency,monthlyIncome:state.monthlyIncome,incomeStability:state.incomeStability,pendingProducts:[...state.pending]},goal:{type:state.goalType,name:state.goalType==='wealth'?`Patrimonio de ${euro(state.goalTarget)}`:GOALS[state.goalType].title,target:state.goalTarget,current,linkedToNetWorth:state.goalType==='wealth',monthlyContribution:state.contribution,deadline:dateIso(deadline)},items,movements:[],rules:{minLiquidityPct:state.minLiquidity,maxConcentrationPct:state.maxConcentration},preferences:{hideSensitive:false},lastUpdated:now()};localStorage.setItem(STORAGE_KEY,JSON.stringify(payload));location.reload()}
  render();
})();
