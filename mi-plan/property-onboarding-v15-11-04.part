    const property = draft.properties.find(item=>item.id===id) || emptyProperty(draft.properties.length);
    const isNew = !draft.properties.some(item=>item.id===property.id);
    if (isNew) draft.properties.push(property);
    draft.editing = property.id; saveDraft();
    if (property.valueMethod === 'purchase') property.estimatedValue = estimateFromPurchase(property.purchasePrice, property.purchaseYear);
    root.dataset.prop1511='editor'; root.classList.add('prop1511');
    root.innerHTML = `<div class="prop1511-shell">
      <p class="kicker">Inmueble ${draft.properties.findIndex(item=>item.id===property.id)+1}</p><h1>Vamos vivienda por <em>vivienda.</em></h1><p class="lead">Solo pedimos los datos necesarios para aproximar patrimonio, deuda e ingresos por alquiler.</p>
      <section class="prop1511-card"><h3>Identificación y uso</h3><div class="prop1511-grid"><label class="prop1511-field">Nombre<input data-prop-field="name" value="${esc(property.name)}" placeholder="Ej. Vivienda habitual"></label><label class="prop1511-field">Te pertenece (%)<input data-prop-field="ownership" type="number" min="0" max="100" value="${clamp(property.ownership,0,100)}"></label></div><label class="prop1511-field" style="margin-top:12px">¿Es tu vivienda habitual?<div class="prop1511-segments"><button type="button" data-prop-habitual="yes" class="${property.habitual?'active':''}">Sí</button><button type="button" data-prop-habitual="no" class="${!property.habitual?'active':''}">No</button></div></label>${property.habitual?'':`<label class="prop1511-field" style="margin-top:12px">¿Cómo la utilizas?<div class="prop1511-segments"><button type="button" data-prop-occupancy="rented" class="${property.occupancy==='rented'?'active':''}">Alquilada</button><button type="button" data-prop-occupancy="available" class="${property.occupancy==='available'?'active':''}">Disponible / uso propio</button></div></label>`}</section>
      <section class="prop1511-card"><h3>Valor aproximado actual</h3><p>Indica una valoración conocida, estima desde el precio de compra o sube una tasación/pantallazo.</p><div class="prop1511-methods"><button type="button" data-prop-value-method="known" class="${property.valueMethod==='known'?'active':''}">Sé su valor</button><button type="button" data-prop-value-method="purchase" class="${property.valueMethod==='purchase'?'active':''}">Precio + año</button><button type="button" data-prop-value-method="document" class="${property.valueMethod==='document'?'active':''}">Subir documento</button></div>${property.valueMethod==='purchase'?`<div class="prop1511-grid" style="margin-top:10px"><label class="prop1511-field">Precio de compra (€)<input data-prop-field="purchasePrice" type="number" min="0" value="${finite(property.purchasePrice)||''}"></label><label class="prop1511-field">Año de compra<input data-prop-field="purchaseYear" type="number" min="1960" max="${yearNow}" value="${property.purchaseYear||''}"></label></div><div class="prop1511-estimate"><span>Estimación de referencia usando un 2 % anual. No sustituye una tasación.</span><strong data-prop-estimate>${money(property.estimatedValue)}</strong></div>`:`<label class="prop1511-field" style="margin-top:10px">Valor actual aproximado (€)<input data-prop-field="currentValue" type="number" min="0" value="${finite(property.currentValue)||''}" placeholder="Ej. 250000"></label>`}<label class="prop1511-upload">Subir tasación, PDF, CSV o pantallazo<input type="file" accept="image/*,application/pdf,.csv,text/csv" data-prop-file="valuation"></label>${property.valuationStatus?`<div class="prop1511-status">✓ ${esc(property.valuationStatus)}</div>`:''}</section>
      <section class="prop1511-card"><h3>Hipoteca</h3><label class="prop1511-field">¿Queda hipoteca pendiente?<div class="prop1511-segments"><button type="button" data-prop-mortgage="yes" class="${property.mortgage?'active':''}">Sí</button><button type="button" data-prop-mortgage="no" class="${!property.mortgage?'active':''}">No</button></div></label>${property.mortgage?`<div class="prop1511-grid" style="margin-top:10px"><label class="prop1511-field">Capital pendiente (€)<input data-prop-field="mortgageRemaining" type="number" min="0" value="${finite(property.mortgageRemaining)||''}"></label><label class="prop1511-field">Cuota mensual (€)<input data-prop-field="mortgageMonthly" type="number" min="0" value="${finite(property.mortgageMonthly)||''}"></label></div><label class="prop1511-upload">Subir recibo, PDF o pantallazo de la hipoteca<input type="file" accept="image/*,application/pdf,.csv,text/csv" data-prop-file="mortgage"></label>${property.mortgageStatus?`<div class="prop1511-status">✓ ${esc(property.mortgageStatus)}</div>`:''}`:''}</section>
      ${property.occupancy==='rented'?`<section class="prop1511-card"><h3>Alquiler</h3><label class="prop1511-field">¿Cuánto cobras al mes? (€)<input data-prop-field="rentMonthly" type="number" min="0" value="${finite(property.rentMonthly)||''}"></label><div class="prop1511-note" style="margin-top:9px">Para esta primera fotografía no pedimos comunidad, IBI ni otros gastos. Buscamos una aproximación útil.</div></section>`:''}
