(() => {
  'use strict';
  const STORAGE_KEY = 'ff_mi_plan_v2';
  const url = new URL(location.href);
  if (url.searchParams.get('nuevo') === '1') {
    try { localStorage.removeItem(STORAGE_KEY); } catch (_) {}
    url.searchParams.delete('nuevo');
    history.replaceState({}, '', url.pathname + (url.search ? url.search : '') + url.hash);
  }
  let existing = null;
  try { existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); } catch (_) {}
  if (existing?.onboardingComplete) return;

  const TYPES = {
    cash:{label:'Banco y efectivo',icon:'€',financial:true,liquid:true}, funds:{label:'Fondos / ETF',icon:'◫',financial:true},
