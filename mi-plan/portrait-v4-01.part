    ['pension','Pensiones','¿Tienes un plan de pensiones o ahorro para la jubilación?','Dinero reservado para el futuro que normalmente no puedes retirar libremente ahora.'],
    ['crypto','Cripto','¿Tienes Bitcoin, Ethereum u otras criptomonedas?','Incluye lo que guardas en plataformas o monederos digitales.'],
    ['realestate','Inmuebles','¿Tienes viviendas, locales, terrenos o garajes en propiedad?','Incluye tu vivienda habitual y cualquier inmueble alquilado o de uso personal.'],
    ['debt','Deudas','¿Tienes hipotecas, préstamos o alguna otra deuda?','El dinero que todavía debes a bancos, familiares o empresas financieras.'],
    ['other','Otros','¿Tienes algún otro activo que quieras incluir?','Por ejemplo, un negocio, participaciones, seguros de ahorro u objetos de valor.']
  ].map(([type,short,question,explanation])=>({type,short,question,explanation,...TYPES[type]}));
