    income:{title:'Generar ingresos mensuales',subtitle:'Dividendos, alquileres y primas',icon:'↗',target:3000},
    wealth:{title:'Construir mi patrimonio',subtitle:'Inversiones, inmuebles y objetivos',icon:'◇',target:500000}
  };
