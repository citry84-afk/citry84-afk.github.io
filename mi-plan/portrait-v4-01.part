  const state={step:0,name:'',household:'individual',answers:{},values:{},meta:{},pending:new Set(),monthlyIncome:0,incomeStability:'stable',contribution:500,goalType:'wealth',goalTarget:500000,goalCurrent:0,horizon:15,frequency:'monthly',detail:'