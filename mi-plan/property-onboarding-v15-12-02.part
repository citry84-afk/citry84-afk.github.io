  }
  function propertyValue(property) {
    return property.valueMethod === 'purchase' ? finite(property.estimatedValue || estimate(property.purchasePrice, property.purchaseYear)) : finite(property.currentValue);
  }
  function totals() {
    return draft.properties.reduce((acc, property) => {
      const factor = clamp(property.ownership,0,100)/100;
      acc.value += propertyValue(property)*factor;
      if (property.mortgage) {
        acc.mortgage += finite(property.mortgageRemaining)*factor;
        acc.mortgageMonthly += finite(property.mortgageMonthly)*factor;
        if (property.mortgageRemaining) acc.mortgageCount += 1;
      }
      if (property.type === 'rented') acc.rent += finite(property.rentMonthly)*factor;
      return acc;
    }, {value:0,mortgage:0,mortgageMonthly:0,mortgageCount:0,rent:0});
  }

  function injectStyles() {
    if ($('style[data-property1512]')) return;
    const style=document.createElement('style');style.dataset.property1512='1';style.textContent=`
      .pw1512{--ink:#0b2240;--muted:#63758c;--line:#d2dfec;--blue:#1674d1;--orange:#ff8613;color:var(--ink)}.pw1512 *{box-sizing:border-box}
      .pw1512-shell{display:grid;gap:14px}.pw1512-progress{display:flex;gap:5px}.pw1512-progress i{height:5px;flex:1;border-radius:9px;background:#dbe7f3}.pw1512-progress i.done{background:linear-gradient(90deg,#287bd1,#ff8613)}
      .pw1512-card{padding:18px;border:1px solid var(--line);border-radius:22px;background:#fff;box-shadow:0 12px 32px rgba(16,54,108,.06)}.pw1512-card h3{margin:0 0 6px;font-size:20px}.pw1512-card p{margin:0 0 15px;color:var(--muted);font-size:12px;line-height:1.5}
      .pw1512-options{display:grid;gap:9px}.pw1512-options.two{grid-template-columns:1fr 1fr}.pw1512-choice{min-height:64px;border:1px solid var(--line);border-radius:16px;padding:12px;background:#f8fbfe;color:var(--ink);text-align:left;font-weight:900}.pw1512-choice small{display:block;margin-top:4px;color:var(--muted);font-size:9px;line-height:1.35}.pw1512-choice.active{border-color:#68a8e0;background:#edf7ff;box-shadow:0 0 0 3px rgba(22,116,209,.08)}
      .pw1512-select{display:grid;gap:6px;color:var(--muted);font-size:11px;font-weight:850}.pw1512-select select{width:100%;min-height:55px;border:1px solid var(--line);border-radius:15px;padding:0 14px;background:#fff;color:var(--ink);font:850 16px system-ui}
      .pw1512-upload{display:flex;align-items:center;justify-content:center;min-height:58px;margin-top:11px;border:1px dashed #76a7d4;border-radius:16px;background:#f4f9fe;color:#145c9d;font-weight:900}.pw1512-upload input{display:none}.pw1512-status{margin-top:9px;padding:10px;border-radius:13px;background:#eef8f3;color:#17634d;font-size:10px;font-weight:850}
      .pw1512-estimate{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:10px;padding:12px;border-radius:14px;background:#0d2b4e;color:#fff}.pw1512-estimate span{color:#bfd2e4;font-size:10px}.pw1512-estimate strong{font-size:19px}
      .pw1512-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.pw1512-summary div{padding:12px;border-radius:15px;background:#f2f7fc}.pw1512-summary span{display:block;color:var(--muted);font-size:9px}.pw1512-summary strong{display:block;margin-top:5px;font-size:16px}
      .pw1512-actions{display:flex;gap:9px}.pw1512-actions button{min-height:53px;border-radius:16px;padding:0 16px;font-weight:950}.pw1512-back{border:1px solid var(--line);background:#fff;color:#526880}.pw1512-next{flex:1;border:0;background:linear-gradient(135deg,#ff941f,#ff790b);color:#fff;box-shadow:0 12px 27px rgba(255,126,15,.22)}.pw1512-next:disabled{opacity:.38;box-shadow:none}
      .pw1512-hero{padding:18px;border-radius:22px;background:linear-gradient(145deg,#0b2b52,#1261a8);color:#fff}.pw1512-hero h2{margin:5px 0;font-size:27px}.pw1512-hero p{margin:0;color:#d1e1ef;font-size:11px}.pw1512-list{display:grid;gap:9px}.pw1512-row{display:grid;grid-template-columns:42px 1fr auto;gap:10px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:16px;background:#fff}.pw1512-row>span:first-child{display:grid;place-items:center;width:40px;height:40px;border-radius:13px;background:#eaf3fd;color:#155994;font-size:20px}.pw1512-row b,.pw1512-row small{display:block}.pw1512-row small{margin-top:3px;color:var(--muted);font-size:9px;line-height:1.4}.pw1512-row button{border:1px solid var(--line);border-radius:11px;padding:8px;background:#f6f9fc;color:#24577f;font-weight:850}
      .pw1512-note{padding:12px;border-radius:14px;background:#fff7ea;color:#76501b;font-size:10px;line-height:1.5}.pw1512-native-hidden{display:none!important}.pw1512-loading{position:fixed;inset:0;z-index:30000;display:grid;place-items:center;background:#04101dcc}.pw1512-loading div{width:min(380px,calc(100% - 30px));padding:20px;border-radius:20px;background:#0d2745;color:#fff}.pw1512-loading span{display:block;margin-top:7px;color:#bcd0e4;font-size:11px}
      body.app-active #onboarding,body.app-active #reveal{pointer-events:none!important}
      @media(max-width:560px){.pw1512-options.two{grid-template-columns:1fr}.pw1512-summary{grid-template-columns:1fr 1fr}}
    `;document.head.appendChild(style);
  }
  function options(list, value, formatter = money) {
    return list.map(item=>`<option value="${item}" ${finite(value)===item?'selected':''}>${formatter(item)}</option>`).join('');
  }
  function yearOptions(value) {
    let html='';for(let year=yearNow;year>=1970;year--)html+=`<option value="${year}" ${finite(value)===year?'selected':''}>${year}</option>`;return html;
  }
  function loading(text) {
    const node=document.createElement('div');node.className='pw1512-loading';node.innerHTML=`<div><b>${esc(text)}</b><span>Procesando el documento en este dispositivo.</span></div>`;document.body.appendChild(node);return node;
  }
  async function loadOCR() {
    if (globalThis.Tesseract) return globalThis.Tesseract;
    await new Promise((resolve,reject)=>{const s=document.createElement('script');s.src=OCR_URL;s.onload=resolve;s.onerror=reject;document.head.appendChild(s)});
    return globalThis.Tesseract;
  }
  async function fileText(file) {
    const type=String(file.type||'').toLowerCase();
    if(type.includes('csv')||type.includes('text'))return file.text();
    if(type.includes('pdf')||/\.pdf$/i.test(file.name)){
      const pdfjs=await import(PDF_URL);pdfjs.GlobalWorkerOptions.workerSrc=PDF_WORKER_URL;
      const pdf=await pdfjs.getDocument({data:await file.arrayBuffer()}).promise;let text='';
      for(let pageNo=1;pageNo<=Math.min(pdf.numPages,5);pageNo++){const page=await pdf.getPage(pageNo);const content=await page.getTextContent();text+='\n'+content.items.map(item=>item.str).join(' ')}return text;
    }
    const tesseract=await loadOCR();const result=await tesseract.recognize(file,'spa+eng');return result?.data?.text||'';
  }
  function parseNumber(raw) {
    let text=String(raw||'').replace(/[^0-9.,-]/g,'');if(!/\d/.test(text))return null;const neg=text.includes('-');text=text.replace(/-/g,'');
    const comma=text.lastIndexOf(','),point=text.lastIndexOf('.');let dec='';if(comma>=0&&point>=0)dec=comma>point?',':'.';else if(comma>=0&&[1,2].includes(text.length-comma-1))dec=',';else if(point>=0&&[1,2].includes(text.length-point-1))dec='.';
    if(dec){const i=text.lastIndexOf(dec);text=text.slice(0,i).replace(/[.,]/g,'')+'.'+text.slice(i+1).replace(/[.,]/g,'')}else text=text.replace(/[.,]/g,'');const n=Number(text);return Number.isFinite(n)?(neg?-n:n):null;
  }
  function amounts(text) {
    const source=String(text||'').replace(/\u00a0/g,' ');const regex=/-?\d{1,3}(?:[.\s]\d{3})*(?:,\d{1,2})?|\d+(?:[.,]\d{2})/g;const out=[];let match;
    while((match=regex.exec(source))){const value=parseNumber(match[0]);if(value===null||value<100||value>5000000)continue;const context=source.slice(Math.max(0,match.index-65),Math.min(source.length,match.index+match[0].length+65)).toLowerCase();out.push({value,context});}return out;
  }
  function analyseDocument(text, kind) {
    const candidates=amounts(text);const lower=String(text||'').toLowerCase();
    const score=(item,words)=>words.reduce((sum,word)=>sum+(item.context.includes(word)?18:0),0)+Math.log10(Math.max(1,item.value));
    if(kind==='valuation'){
      const filtered=candidates.filter(item=>item.value>=20000);const best=filtered.sort((a,b)=>score(b,['tasaci','valor de mercado','valor vivienda','precio','inmueble'])-score(a,['tasaci','valor de mercado','valor vivienda','precio','inmueble'])||b.value-a.value)[0];
      return {value:best?.value||0};
    }
    const remaining=candidates.filter(item=>item.value>=5000).sort((a,b)=>score(b,['capital pendiente','principal pendiente','saldo pendiente','hipoteca'])-score(a,['capital pendiente','principal pendiente','saldo pendiente','hipoteca'])||b.value-a.value)[0];
    const monthly=candidates.filter(item=>item.value>=100&&item.value<=5000).sort((a,b)=>score(b,['cuota','mensualidad','recibo'])-score(a,['cuota','mensualidad','recibo']))[0];
    return {remaining:remaining?.value||0,monthly:monthly?.value||0,detected:/hipoteca|pr[eé]stamo|capital pendiente/i.test(lower)};
  }
  async function importDocument(file, kind, property) {
    const wait=loading(kind==='valuation'?'Leyendo la valoración…':'Leyendo la hipoteca…');
    try{
      const text=await fileText(file);const result=analyseDocument(text,kind);
      if(kind==='valuation'){
        if(!result.value)throw new Error('No se encontró una valoración clara');
        property.valueMethod='known';property.currentValue=nearest(result.value,VALUES,200000);property.valuationFile={name:file.name,type:file.type,size:file.size};property.valuationStatus=`Valor propuesto: ${money(property.currentValue)}`;
      }else{
        property.mortgage=true;property.mortgageRemaining=nearest(result.remaining,MORTGAGES,100000);property.mortgageMonthly=nearest(result.monthly,PAYMENTS,750);property.mortgageFile={name:file.name,type:file.type,size:file.size};property.mortgageStatus=`Pendiente ${money(property.mortgageRemaining)} · cuota ${money(property.mortgageMonthly)}`;
      }
