ss="summary-avatar">${people()}</span></div><div class="summary-list">${DISCOVERY.filter(d=>state.answers[d.type]==='yes'||state.answers[d.type]==='unsure').map(d=>`<div class="summary-row"><span>${d.icon} ${d.short}</span><b>${state.answers[d.type]==='unsure'?'Pendiente':safe(state.values[d.type])?euro(state.values[d.type]):'Sin cifra'}</b></div>`).join('')||'<div class="summary-row"><span>Patrimonio</span><b>Lo completarás después</b></div>'}</div><div class="source-legend"><span><i class="estimated"></i>Estimado ahora</span><span><i class="entered"></i>Introducido por ti</span><span><i class="imported"></i>Importado después</span><span><i class="synced"></i>Sincronizado en el futuro</span></div>`}
  function calcGoalCurrent(){const t=totals();return state.goalType==='wealth'?t.netWorth:state.goalType==='income'?t.passive:state.goalType==='calm'?safe(state.values.cash):state.goalCurrent}
  function renderMap(){const t=totals(),inc=DISCOVERY.filter(d=>state.answers[d.type]==='yes'||state.answers[d.type]==='unsure'),lines=inc.map((d,i)=>{const[x,y]=POS[i];return`<line x1="50" y1="50" x2="${x}" y2="${y}"/>`}).join(''),nodes=inc.map((d,i)=>{const[x,y]=POS[i],u=state.answers[d.type]==='unsure',v=safe(state.values[d.type]);return`<div class="map-node ${u?'uncertain':''} ${d.type==='debt'?'debt':''}" style="--x:${x}%;--y:${y}%"><span>${d.icon}</span><b>${d.short}</b><small>${u?'Pendiente':v?euro(v,true):'Por completar'}</small></div>`}).join(''),initials=(state.name||'Tú').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();map.innerHTML=`<div class="map-preview-head"><div><small>Tu fotografía se construye en directo</small><strong>${state.household==='individual'?'Mapa personal':state.household==='couple'?'Mapa de pareja':'Mapa familiar'}</strong></div><div class="preview-avatar">${initials}</div></div><div class="financial-map"><svg viewBox="0 0 100 100">${lines}</svg>${nodes}<div class="map-center"><span class="people-art">${people()}</span><b>${esc(state.name||'Tú')}</b><small>${inc.length?`${inc.length} piezas añadidas`:'Empezamos contigo'}</small></div></div><div class="map-footer"><div><span>Patrimonio estimado</span><strong>${euro(t.netWorth,true)}</strong></div><div><span>Ingresos pasivos</span><strong>${euro(t.passive)}</strong></div></div>`}
  function render(){const{f,s}=current();label.textContent=s.label;counter.textContent=s.counter;progress.style.width=`${s.progress}%`;content.innerHTML=s.render();back.style.visibility=state.step?'visible':'hidden';next.style.visibility=s.kind==='ask'?'hidden':'visible';next.disabled=!s.valid();next.innerHTML=s.kind==='summary'?'Crear mi sistema <span>✦</span>':s.kind==='detail'?'Añadir al mapa <span>→</span>':'Continuar <span>→</span>';renderMap();bind()}
  function toast(msg){const el=$('#portraitToast');el.textContent=msg;el.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>el.classList.remove('show'),1500);map.classList.remove('map-pulse');void map.offsetWidth;map.classList.add('map-pulse');if(navigator.vibrate)navigator.vibrate([6,20,8])}
  function joy(title,text,icon='✓',done){const el=$('#portraitJoy');$('#portraitJoyTitle').textContent=title;$('#portraitJoyText').textContent=text;$('#portraitJoyIcon').textContent=icon;el.classList.add('show');if(navigator.vibrate