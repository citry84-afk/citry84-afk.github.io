monthlyIncome*100):'—'}</strong><small>Parte de tus ingresos destinada a objetivos.</small></div>`}
  function goal(){const c=calcGoalCurrent();return`<p class="kicker">Ya conocemos tu punto de partida</p><h1>¿Qué quieres conseguir <em>primero?</em></h1><p class="lead">El panel destacará el objetivo que más te importa ahora.</p><div class="goal-grid">${Object.entries(GOALS).map(([k,g])=>`<button class="goal-option ${state.goalType===k?'selected':''}" data-goal="${k}"><span class="symbol">${g.icon}</span><b>${g.title}</b><small>${g.subtitle}</small></button>`).join('')}</div><div class="fields-2 p-gap"><div class="field">${info(state.goalType==='income'?'¿Qué ingreso mensual quieres?':'¿Cuánto quieres alcanzar?','target')}<input id="pTarget" type="number" min="1" value="${state.goalTarget}"></div><div class="field">${info('¿En cuántos años?','target')}<input id="pHorizon" type="number" min="1" value="${state.horizon}"></div></div>${state.goalType==='home'?`<div class="field p-gap">${info('¿Cuánto tienes ya reservado?','value')}<input id="pGoalCurrent" type="number" min="0" value="${state.goalCurrent}"></div>`:`<div class="auto-progress-note"><span>✓</span><div><b>Calcularemos automáticamente tu progreso.</b><small>Partiría de ${euro(c)} según tu fotografía.</small></div></div>`}`}
  function prefs(){return`<p class="kicker">Tu sistema debe adaptarse a ti</p><h1>Elige cómo quieres <em>verlo y controlarlo.</em></h1><p class="lead">Puedes cambiarlo en cualquier momento.</p><div class="fields-2"><div class="field"><span>¿Cada cuánto quieres revisarlo?</span><select id="pFrequency"><option value="weekly" ${state.frequency==='weekly'?'selected':''}>Cada semana</option><option value="monthly" ${state.frequency==='monthly'?'selected':''}>Cada mes</option><option value="alerts" ${state.frequency==='alerts'?'selected':''}>Solo si hay algo que revisar</option></select></div><div class="field"><span>¿Cuánta información quieres ver?</span><select id="pDetail"><option value="essential" ${state.detail==='essential'?'selected':''}>Esencial</option><option value="complete" ${state.detail==='complete'?'selected':''}>Completo y explicado</option><option value="advanced" ${state.detail==='advanced'?'selected':''}>Avanzado</option></select></div></div><p class="kicker p-gap">Tus límites personales <button class="info-button" data-phelp="rules">i</button></p><div class="fields-2"><div class="field"><span>Dinero disponible mínimo (%)</span><input id="pLiquidity" type="number" min="0" max="100" value="${state.minLiquidity}"></div><div class="field"><span>Máximo en una inversión (%)</span><input id="pConcentration" type="number" min="1" max="100" value="${state.maxConcentration}"></div></div>`}
  function summary(){const t=totals(),yes=DISCOVERY.filter(d=>state.answers[d.type]==='yes'),pending=DISCOVERY.filter(d=>state.answers[d.type]==='unsure');return`<p class="kicker">Ya tenemos tu punto de partida</p><h1>Esta es tu primera <em>fotografía financiera.</em></h1><p class="lead">No tiene que ser perfecta. La iremos afinando al añadir detalles, subir archivos o conectar cuentas.</p><div class="summary-hero"><div><span>Patrimonio neto estimado</span><strong>${euro(t.netWorth)}</strong><small>${yes.length} categorías · ${pending.length} pendientes</small></div><span cla