;if(['cash','funds','stocks','pension'].includes(d.type))extra=`<div class="fields-2"><div class="field">${info(d.type==='cash'?'¿En cuántos bancos?':'¿Cuántos productos?','count')}<input id="pCount" type="number" min="1" value="${m.count}"></div><div class="field">${info('¿Cuánto añades cada mes?','contribution')}<input id="pMonthlyContribution" type="number" min="0" value="${m.monthlyContribution}"></div></div>`;if(d.type==='realestate')extra=`<div class="fields-2"><div class="field">${info('¿Cuántos inmuebles?','count')}<input id="pCount" type="number" min="1" value="${m.count}"></div><div class="field">${info('¿Cuánto alquiler cobras al mes?','income')}<input id="pMonthlyAssetIncome" type="number" min="0" value="${m.monthlyIncome}"></div></div>`;if(d.type==='options')extra=`<div class="field">${info('¿Cuánto ingresas de media al mes con opciones?','income')}<input id="pMonthlyAssetIncome" type="number" min="0" value="${m.monthlyIncome}"></div>`;if(d.type==='debt')extra=`<div class="field">${info('¿Cuánto pagas al mes entre cuotas?','value')}<input id="pMonthlyPayment" type="number" min="0" value="${m.monthlyPayment}"></div>`;return`<p class="kicker">Ya sabemos que sí</p><h1>Cuéntame un poco más sobre <em>${d.short.toLowerCase()}.</em></h1><p class="lead">Una aproximación es suficiente. Quedará marcado como estimado hasta que lo actualices o importes.</p><div class="field">${info(vq,'value')}<div class="range-chips">${ranges(d.type).map(([n,l])=>`<button class="range-chip ${v===n&&!m.unknown?'selected':''}" data-range="${n}">${l}</button>`).join('')}</div><input id="pValue" type="number" min="0" value="${m.unknown?'':v||''}" placeholder="O escribe una cifra aproximada" ${m.unknown?'disabled':''}><button class="unknown-value ${m.unknown?'selected':''}" data-unknown><span>${m.unknown?'✓':'?'}</span>No sé la cifra todavía</button></div><div class="field">${info(wq,'where')}<input id="pWhere" value="${esc(m.where)}" placeholder="Ej. ${ph}"></div>${extra}<div class="estimated-badge"><span>≈</span><div><b>Dato estimado</b><small>Después podrá ser introducido, importado o sincronizado.</small></div></div>`}
  function income(){return`<p class="kicker">Cómo se mueve tu dinero</p><h1>¿Qué ritmo tiene <em>tu hogar?</em></h1><p class="lead">Esto nos permite medir el esfuerzo real y evitar objetivos imposibles de mantener.</p><div class="fields-2"><div class="field">${info('¿Cuánto dinero entra cada mes?','income')}<input id="pIncome" type="number" min="0" value="${state.monthlyIncome||''}" placeholder="Ej. 5200"></div><div class="field">${info('¿Cuánto puedes ahorrar o invertir?','contribution')}<input id="pContribution" type="number" min="0" value="${state.contribution}"></div></div><div class="field p-gap">${info('¿Tus ingresos suelen ser estables?','income')}<div class="stability-grid">${[['stable','Sí, bastante estables','Cantidad parecida'],['variable','Cambian bastante','Usaremos una media'],['mixed','Una parte fija y otra variable','Combinación']].map(([k,t,s])=>`<button class="stability-option ${state.incomeStability===k?'selected':''}" data-stability="${k}"><b>${t}</b><small>${s}</small></button>`).join('')}</div></div><div class="ratio-card"><span>Capacidad mensual estimada</span><strong>${state.monthlyIncome?pct(state.contribution/state.