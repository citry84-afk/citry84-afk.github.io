h4{margin:0;font-size:12px}.ot11-trade p{margin:4px 0 0;color:var(--muted);font-size:9px}.ot11-trade>span,.ot11-trade>b{text-align:right;font-size:11px}.ot11-pill{display:inline-flex;width:max-content;align-items:center;gap:5px;padding:5px 8px;border-radius:999px;background:#17365e;color:#9dc4ff;font-size:9px;font-weight:900}.ot11-pill.orange{background:#422810;color:#ffc08b}.ot11-pill.green{background:#113b35;color:#82e8ce}.ot11-pill.red{background:#43222a;color:#ffacb5}.ot11-strategies{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ot11-strategy{padding:15px;border:1px solid #203650;border-radius:17px;background:#0a192b}.ot11-strategy-head{display:flex;justify-content:space-between;gap:10px}.ot11-strategy h4{margin:0;font-size:13px}.ot11-strategy p{margin:5px 0 0;color:var(--muted);font-size:10px}.ot11-strategy-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:13px}.ot11-strategy-metrics div{padding:8px;border-radius:10px;background:#0f2138}.ot11-strategy-metrics span{display:block;color:#6f87a8;font-size:8px}.ot11-strategy-metrics b{display:block;margin-top:4px;font-size:10px}.ot11-empty{display:grid;place-items:center;min-height:210px;padding:24px;text-align:center;border:1px dashed #27415f;border-radius:17px;background:#081625}.ot11-empty span{font-size:38px}.ot11-empty b{display:block;margin-top:10px}.ot11-empty p{max-width:360px;margin:6px auto 15px;color:var(--muted);font-size:11px;line-height:1.5}.ot11-import{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;padding:17px;border:1px solid #294562;border-radius:18px;background:linear-gradient(135deg,#102947,#0a1a2e)}.ot11-import h3{margin:0;font-size:15px}.ot11-import p{margin:5px 0 0;color:var(--muted);font-size:10px;line-height:1.45}.ot11-note{padding:11px 13px;border-radius:13px;background:#13253c;color:#88a0bf;font-size:10px;line-height:1.45}.ot11-note strong{color:#fff}.ot11-drawer{position:fixed;inset:0;z-index:99999;display:none;place-items:center;padding:18px;background:rgba(3,10,20,.68);backdrop-filter:blur(10px)}.ot11-drawer.show{display:grid}.ot11-sheet{width:min(620px,100%);max-height:88vh;overflow:auto;padding:22px;border:1px solid #284463;border-radius:24px;background:#0a1728;color:#fff;box-shadow:0 35px 100px #0008}.ot11-sheet-head{display:flex;justify-content:space-between;gap:12px}.ot11-sheet h3{margin:0}.ot11-close{width:42px;height:42px;border:1px solid #29425f;border-radius:50%;background:#10243c;color:#fff;font-size:23px}.ot11-toast{position:fixed;left:50%;bottom:90px;z-index:999999;transform:translate(-50%,18px);opacity:0;padding:11px 16px;border-radius:999px;background:#fff;color:#07162a;font-weight:900;font-size:12px;box-shadow:0 15px 50px #0005;transition:.25s}.ot11-toast.show{opacity:1;transform:translate(-50%,0)}
@keyframes ot11grow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@media(max-width:900px){.ot11-summary{grid-template-columns:repeat(3,1fr)}.ot11-grid{grid-template-columns:1fr}.ot11-card.full{grid-column:auto}}
@media(max-width:620px){.ot11{margin:0 -5px 105px;padding:11px;border-radius:21px}.ot11-top{display:grid}.ot11-actions{justify-content:flex-start}.ot11-summary{grid-template-columns:repeat(2,1fr)}.ot11-kpi{min-height:100px}.ot11-months{grid-template-columns:repeat(3,1fr)}.ot11-calendar{gap:3px}.ot11-day{min-height:50px;padding:5px}.ot11-day b{margin-top:8px;font-size:8px}.ot11-trade{grid-template-columns:1fr auto}.ot11-trade>*:nth-child(2){display:none}.ot11-trade>*:nth-child(3){text-align:left}.ot11-strategies{grid-template-columns:1fr}.ot11-import{grid-template-columns:1fr}.ot11-big{font-size:20px}.ot11-card{padding:14px}}
