document.head.appendChild(style);

function parseCSV(text){
  const out=[];let row=[],field='',quoted=false;
  for(let i=0;i<text.length;i++){
    const c=text[i];
    if(quoted){if(c==='"'&&text[i+1]==='"'){field+='"';i++}else if(c==='"')quoted=false;else field+=c}
    else{if(c==='"')quoted=true;else if(c===','){row.push(field);field=''}else if(c==='\n'){row.push(field.replace(/\r$/,''));out.push(row);row=[];field=''}else field+=c}
  }
  if(field||row.length){row.push(field);out.push(row)}
  return out;
}
function symbolParts(symbol){
  const m=String(symbol).match(/^([A-Z0-9.]+)\s+(\d{2}[A-Z]{3}\d{2})\s+([\d.]+)\s+([PC])$/);
  return m?{underlying:m[1],expiry:m[2],strike:num(m[3]),right:m[4]}:{underlying:String(symbol||''),expiry:'',strike:0,right:''};
}
function detectBoxes(open){
  const groups={};
  open.forEach(p=>{const key=`${p.underlying}|${p.expiry}`;(groups[key]??=[]).push(p)});
  const boxes=[];
  Object.values(groups).forEach(g=>{
    const strikes=[...new Set(g.map(x=>x.strike))].sort((a,b)=>a-b);
    if(g.length===4&&strikes.length===2&&strikes.every(s=>g.some(x=>x.strike===s&&x.right==='C')&&g.some(x=>x.strike===s&&x.right==='P'))){g.forEach(x=>x.structure='box');boxes.push({underlying:g[0].underlying,expiry:g[0].expiry,strikes,legs:g})}
  });
  return boxes;
}
function detectRolls(trades){
  const groups={};
  trades.forEach(t=>{const key=`${datePart(t.date)}|${t.underlying}|${t.right}`;(groups[key]??=[]).push(t)});
  return Object.entries(groups).filter(([,g])=>g.some(t=>String(t.code).includes('C')&&t.quantity>0)&&g.some(t=>String(t.code).includes('O')&&t.quantity<0)).map(([key,legs])=>({key,date:datePart(legs[0].date),underlying:legs[0].underlying,right:legs[0].right,legs,credit:legs.reduce((s,t)=>s+t.proceeds+t.commission,0)}));
}
function analyse(rows,name){
  const open=[],trades=[],events=[];
  for(const r of rows){
    if(r[0]==='Posiciones abiertas'&&r[1]==='Data'&&String(r[3]).includes('Opciones')){
      const p=symbolParts(r[5]);open.push({...p,symbol:r[5],currency:r[4]||'USD',quantity:num(r[6]),multiplier:num(r[7])||100,costPrice:num(r[8]),costBasis:num(r[9]),closePrice:num(r[10]),value:num(r[11]),unrealized:num(r[12]),structure:''});
    }
    if(r[0]==='Operaciones'&&r[1]==='Data'&&String(r[3]).includes('Opciones')){
      const p=symbolParts(r[5]);const code=r[15]||'';const t={...p,symbol:r[5],currency:r[4]||'USD',date:r[6],quantity:num(r[7]),price:num(r[8]),proceeds:num(r[10]),commission:num(r[11]),realized:num(r[13]),mtm:num(r[14]),code};trades.push(t);
      if(code.includes('A;C'))events.push({...t,event:'assignment'});else if(code.includes('C;Ep'))events.push({...t,event:'expiration'});else if(code.includes('C;Ex'))events.push({...t,event:'exercise'});
    }
  }
  const boxes=detectBoxes(open),rolls=detectRolls(trades);
  const naked=open.filter(x=>x.right==='P'&&x.quantity<0&&x.structure!=='box');
  const exposure=naked.reduce((s,x)=>s+x.strike*Math.abs(x.quantity)*x.multiplier,0);
  const realized=trades.reduce((s,x)=>s+x.realized,0);
  const summary={file:name,rows:rows.length,openCount:open.length,tradeCount:trades.length,boxes:boxes.length,nakedPuts:naked.length,assignmentExposure:exposure,realized,unrealized:open.reduce((s,x)=>s+x.unrealized,0),assignments:events.filter(e=>e.event==='assignment').length,expirations:events.filter(e=>e.event==='expiration').length,exercises:events.filter(e=>e.event==='exercise').length,rolls:rolls.length,updatedAt:new Date().toISOString()};
  return{open,trades,events,rolls,summary};
}
function closedTrades(d){return(d.trades||[]).filter(t=>Math.abs(num(t.realized))>.0001)}
function stats(d){
  const closed=closedTrades(d),wins=closed.filter(t=>t.realized>0),losses=closed.filter(t=>t.realized<0),be=closed.filter(t=>t.realized===0);
  const grossWin=wins.reduce((s,t)=>s+t.realized,0),gro