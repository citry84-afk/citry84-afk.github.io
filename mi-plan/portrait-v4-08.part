)navigator.vibrate([12,30,16]);setTimeout(()=>{el.classList.remove('show');done?.()},650)}
  function help(key){const h=HELP[key];if(!h)return;$('#portraitHelpTitle').textContent=h[0];$('#portraitHelpText').textContent=h[1];$('#portraitHelpExample').textContent=h[2];$('#portraitHelp').showModal()}
  function bind(){const{f,s}=current();$$('[data-phelp]',content).forEach(b=>b.onclick=e=>{e.preventDefault();help(b.dataset.phelp)});$$('[data-household]',content).forEach(b=>b.onclick=()=>{state.household=b.dataset.household;render();toast('👥 Mapa actualizado')});$$('[data-answer]',content).forEach(b=>b.onclick=()=>{const type=b.dataset.type,ans=b.dataset.answer;state.answers[type]=ans;if(ans==='yes'){state.pending.delete(type);meta(type)}else{if(ans==='unsure')state.pending.add(type);else state.pending.delete(type)}renderMap();toast(ans==='yes'?'✨ Pieza añadida':ans==='unsure'?'? Lo dejamos pendiente':'✓ Anotado');setTimeout(()=>{state.step++;render()},350)});$$('[data-range]',content).forEach(b=>b.onclick=()=>{const type=s.type;meta(type).unknown=false;state.values[type]=safe(b.dataset.range);render();toast('≈ Cifra aproximada guardada')});$('[data-unknown]',content)?.addEventListener('click',()=>{meta(s.type).unknown=!meta(s.type).unknown;if(meta(s.type).unknown)state.values[s.type]=0;render();toast('? Sin problema, queda pendiente')});$$('[data-goal]',content).forEach(b=>b.onclick=()=>{state.goalType=b.dataset.goal;state.goalTarget=GOALS[state.goalType].target;render();toast('🎯 Objetivo elegido')});$$('[data-stability]',content).forEach(b=>b.onclick=()=>{state.incomeStability=b.dataset.stability;render();toast('✓ Ritmo anotado')});const mapInput=(sel,event,fn)=>$(sel,content)?.addEventListener(event,e=>{fn(e.target.value);renderMap();next.disabled=!current().s.valid()});mapInput('#pName','input',v=>state.name=v);mapInput('#pValue','input',v=>{state.values[s.type]=safe(v);meta(s.type).unknown=false});mapInput('#pWhere','input',v=>meta(s.type).where=v);mapInput('#pCount','input',v=>meta(s.type).count=Math.max(1,safe(v)));mapInput('#pMonthlyContribution','input',v=>meta(s.type).monthlyContribution=safe(v));mapInput('#pMonthlyAssetIncome','input',v=>meta(s.type).monthlyIncome=safe(v));mapInput('#pMonthlyPayment','input',v=>meta(s.type).monthlyPayment=safe(v));mapInput('#pIncome','input',v=>state.monthlyIncome=safe(v));mapInput('#pContribution','input',v=>state.contribution=safe(v));mapInput('#pTarget','input',v=>state.goalTarget=safe(v));mapInput('#pHorizon','input',v=>state.horizon=Math.max(1,safe(v)));mapInput('#pGoalCurrent','input',v=>state.goalCurrent=safe(v));mapInput('#pFrequency','change',v=>state.frequency=v);mapInput('#pDetail','change',v=>state.detail=v);mapInput('#pLiquidity','input',v=>state.minLiquidity=safe(v));mapInput('#pConcentration','input',v=>state.maxConcentration=safe(v))}
  back.onclick=()=>{if(state.step){state.step--;render()}};
  next.onclick=()=>{const{f,s}=current();if(!s.valid())return;if(s.kind==='summary'){joy('¡Fotografía completada!','Estamos creando tu sistema personalizado.','✨',finish);return}const msg=s.kind==='detail'?[`¡${DISCOVERY.find(d=>d.type===s.type).short} añadido!`,'Tu mapa ya es un poco más completo.',DISCOVERY.find(d=>d.type===s.type).icon]:s.kind==='intro'?['¡Empezamos!','Ya tenemos a la persona