(async()=>{try{const unzip=async b64=>{const bytes=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));if(!('DecompressionStream'in window))throw new Error('Tu navegador necesita una versión más reciente para cargar el módulo de opciones.');const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));return await new Response(stream).text()};const css=await unzip('