iv>`}
function capitalOptions(){const base=baseData();return(base?.items||[]).filter(x=>x.type==='options').reduce((s,x)=>s+num(x.value),0)}
function dashboard(d){
  const s=stats(d),sum=d.summary||{},pf=Number.isFinite(s.profitFactor)?s.profitFactor.toFixed(2):s.profitFactor===Infinity?'∞':'—',latest=monthlyData(d).at(-1),cap=capitalOptions();
  return`<div class="ot11" data-options-v11><input id="ot11File" type="file" accept=".csv,text/csv" hidden><div class="ot11-top"><div class="ot11-title"><small><i></i>${sum.file?'IBKR · CSV IMPORTADO':'CENTRO DE OPCIONES'}</small><h2>Opciones</h2><p>${sum.file?`Actualizado desde ${esc(sum.file)}`:'Importa tu actividad para construir el diario automáticamente.'}</p></div><div class="ot11-actions"><button class="ot11-btn" data-ot11-flex>⚡ Automatizar con Flex</button><button class="ot11-btn primary" data-ot11-import>⇧ Importar CSV</button></div></div><nav class="ot11-tabs"><button class="active" data-ot11-tab="dashboard">Dashboard</button><button data-ot11-tab="calendar">Calendario</button><button data-ot11-tab="trades">Operaciones</button><button data-ot11-tab="positions">Posiciones</button></nav>
  <section class="ot11-view active" data-ot11-view="dashboard"><div class="ot11-summary"><div class="ot11-kpi"><span>P&L acumulado</span><strong class="${s.realized>=0?'good':'bad'}">${euro(s.realized,true)}</strong><small>Resultado realizado informado</small></div><div class="ot11-kpi"><span>Profit factor</span><strong>${pf}</strong><small>Ganancia bruta / pérdida bruta</small></div><div class="ot11-kpi"><span>Win rate</span><strong>${pct(s.winRate)}</strong><small>${s.wins} W · ${s.losses} L</small></div><div class="ot11-kpi"><span>Capital opciones</span><strong>${cap?euro(cap,true,'EUR'):'—'}</strong><small>${cap?'Según tu mapa':'Completa el mapa financiero'}</small></div><div class="ot11-kpi"><span>Asignaciones</span><strong>${sum.assignments||0}</strong><small>${sum.expirations||0} vencimientos</small></div><div class="ot11-kpi"><span>Buying power</span><strong>—</strong><small>Pendiente de Flex automático</small></div></div><div class="ot11-grid"><article class="ot11-card"><div class="ot11-card-head"><div><h3>P&L acumulado</h3><p>Evolución diaria del resultado realizado.</p></div><div class="ot11-big">${euro(s.realized)}<small>${latest?`${monthName(latest.month)} ${euro(latest.pnl,true)}`:'sin datos'}</small></div></div>${cumulativeChart(d)}</article><article class="ot11-card"><div class="ot11-card-head"><div><h3>Resultado por ticker</h3><p>Qué subyacentes explican el P&L.</p></div></div>${rank(d)}</article><article class="ot11-card full"><div class="ot11-card-head"><div><h3>P&L mensual</h3><p>Resultado y volumen de actividad por mes.</p></div><span class="ot11-pill">${monthlyData(d).at(-1)?.month?.slice(0,4)||new Date().getFullYear()}</span></div>${monthGrid(d)}</article><article class="ot11-card full"><div class="ot11-import"><div><h3>De archivo manual a sincronización automática</h3><p>El mismo modelo de datos funcionará con Flex Web Service. El token se guardará en servidor, nunca en este navegador.</p></div><button class="ot11-btn blue" data-ot11-flex>Preparar conexión Flex</button></div></article></div></section>
  <section class="ot11-view" data-ot11-view="calendar"><div class="ot11-grid"><article class="ot11-card full"><div class="ot11-card-head"><div><h3>Calendario de P&L diario</h3><p>Verde para jornadas positivas y rojo para jornadas negativas.</p></div><div class="ot11-big">${euro(dailyData(d).reduce((s,x)=>s+x.value,0),true)}<small>periodo importado</small></div></div>${calendar(d)}</article><article class="ot11-card"><div class="ot11-card-head"><div><h3>Eventos automáticos</h3><p>Asignaciones, ejercicios y expiraciones.</p></div></div><div class="ot11-summary" style="grid-template-columns:repeat(3,1fr)"><div class="ot11-kpi"><span>Asignaciones</span><strong>${sum.assignments||0}</strong></div><div class="ot11-kpi"><span>Vencimientos</span><strong>${sum.expirations||0}</strong></div><div class="ot11-kpi"><span>Ejercicios</span><strong>${sum.exercises||0}</strong></div></div></article><article class="ot11-card"><div class="ot11-card-head"><div><h3>Rolls detectados</h3><p>Cierre y nueva apertura del mismo subyacente en el mismo día.</p></div></div><div class="ot11-big" style="text-align:left">${sum.rolls||0}<small style="text-align:left">detección preliminar</small></div><div class="ot11-note"><strong>Siguiente mejora:</strong> encadenar el crédito acumulado hasta el cierre definitivo.</div></article></div></section>
  <section class="ot11-view" data-ot11-view="trades"><article class="ot11-card"><div class="ot11-card-head"><div><h3>Diario de operaciones</h3><p>Aperturas, cierres y eventos importados desde IBKR.</p></div><span class="ot11-pill">${sum.tradeCount||0} filas</span></div>${recentTrades(d)}</article></section>
  <section class="ot11-view" data-ot11-view="positions"><div class="ot11-grid"><article class="ot11-card full"><div class="ot11-card-head"><div><h3>Estrategias abiertas</h3><p>Las patas de un box spread se agrupan en una sola estructura.</p></div><span class="ot11-pill orange">${sum.openCount||0} patas</span></div>${openStrategies(d)}</article><article class="ot11-card"><div class="ot11-card-head"><div><h3>Exposición por asignación</h3><p>Solo puts vendidas independientes.</p></div></div><div class="ot11-big" style="text-align:left">${euro(sum.assignmentExposure||0)}<small style="text-align:left">${sum.nakedPuts||0} puts abiertas</small></div></article><article class="ot11-card"><div class="ot11-card-head"><div><h3>Resultado no realizado</h3><p>Valoración de las posiciones abiertas.</p></div></div><div class="ot11-big ${sum.unrealized>=0?'good':'bad'}" style="text-align:left;color:${sum.unrealized>=0?'var(--green)':'var(--red)'}">${euro(sum.unrealized||0)}<small style="text-align:left">según cierre del extracto</small></div></article></div></section></div>`;
}
function ensureDrawer(){if(document.querySelector('.ot11-drawer'))return;document.body.insertAdjacentHTML('beforeend',`<div class="ot11-drawer"><div class="ot11-sheet"><div class="ot11-sheet-head"><div><span class="ot11-pill orange">AUTOMATIZACIÓN</span><h3>Conexión con IBKR Flex</h3></div><button class="ot11-close" data-ot11-close>×</button></div><p style="color:#8fa3bf;line-height:1.55">La experiencia final será automática. Esta pantalla muestra la arquitectura que prepararemos:</p><div class="ot11-list"><div class="ot11-trade"><div><h4>1. Consulta Flex de solo lectura</h4><p>Operaciones, posiciones, NAV, buying power y exceso de liquidez.</p></div><span class="ot11-pill green">IBKR</span></div><div class="ot11-trade"><div><h4>2. Sincronización diaria</h4><p>El servidor descarga únicamente los cambios nuevos.</p></div><span class="ot11-pill">Automático</span></div><div class="ot11-trade"><div><h4>3. Motor de estrategias</h4><p>Agrupa rolls, asignaciones, puts y box spreads.</p></div><span class="ot11-pill orange">FinanzasFácil</span></div></div><div class="ot11-note"><strong>Seguridad:</strong> no introduzcas todavía ningún token. La conexión necesita backend y cifrado; no se guardará en localStorage.</div><button class="ot11-btn primary" data-ot11-close style="margin-top:16px">Entendido</button></div></div>`)}
function toast(msg){let el=document.querySelector('.ot11-toast');if(!el){el=document.createElement('div');el.className='ot11-toast';document.body.appendChild(el)}el.textContent=msg;el.classList.add('show');clearTimeout(toast.t);